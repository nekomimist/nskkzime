set(NSKKZIME_HOST_BUILD_DIRECTORY "${PROJECT_SOURCE_DIR}/out/build/windows-x64-zenz" CACHE PATH "x64 service build directory")
# Build scope is independent of x86's directory and shared-profile behavior.
set(NSKKZIME_TEST_TSF_DLL "" CACHE FILEPATH "Optional DLL tested by the companion hosts")
if(NSKKZIME_X86_COMPANION)
  set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${NSKKZIME_HOST_BUILD_DIRECTORY}/$<CONFIG>/x86")
  add_compile_definitions(NSKKZIME_X86_COMPANION)
elseif(NSKKZIME_ARM64X_MODE OR NSKKZIME_TEST_TSF_DLL)
  set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${PROJECT_SOURCE_DIR}/out/arm64x/$<CONFIG>")
endif()
include(cmake/windows_runtime.cmake)
if(NOT NSKKZIME_X86_COMPANION)
  set_target_properties(nskkzime_tsf PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/$<CONFIG>")
endif()
set(_test_dll "$<TARGET_FILE:nskkzime_tsf>")
if(NSKKZIME_TEST_TSF_DLL)
  set(_test_dll "${NSKKZIME_TEST_TSF_DLL}")
  if(NOT NSKKZIME_ARM64X_MODE)
    set_target_properties(nskkzime_tsf PROPERTIES EXCLUDE_FROM_ALL TRUE)
  endif()
endif()
add_executable(ime_probe WIN32 src/tools/ime_probe.cpp)
target_include_directories(ime_probe PRIVATE src/windows)
target_link_libraries(ime_probe PRIVATE project_options ole32 oleaut32 uuid user32 gdi32 shell32)
add_executable(ime_probe_local WIN32 src/tools/ime_probe.cpp src/tools/ime_probe_local.manifest)
target_include_directories(ime_probe_local PRIVATE src/windows)
target_link_libraries(ime_probe_local PRIVATE project_options ole32 oleaut32 uuid user32 gdi32 shell32)
target_compile_definitions(ime_probe_local PRIVATE NSKKZIME_LOCAL_PROBE)
if(NOT NSKKZIME_TEST_TSF_DLL OR NSKKZIME_ARM64X_MODE)
  add_dependencies(ime_probe_local nskkzime_tsf)
endif()
include(cmake/build_metadata.cmake)
if(NSKKZIME_ARM64X_MODE)
  include(cmake/arm64x.cmake)
endif()
if(BUILD_TESTING)
  add_executable(tsf_smoke tests/tsf_smoke.cpp)
  target_include_directories(tsf_smoke PRIVATE src/windows include)
  target_link_libraries(tsf_smoke PRIVATE project_options ole32 oleaut32 uuid user32)
  target_compile_definitions(tsf_smoke PRIVATE NSKKZIME_TEST_DICTIONARY=L"${PROJECT_SOURCE_DIR}/tests/fixtures/basic.utf8.skk")
  add_test(NAME tsf_smoke COMMAND tsf_smoke ${_test_dll} ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/basic.utf8.skk)
  add_executable(tsf_learning tests/tsf_learning.cpp)
  target_link_libraries(tsf_learning PRIVATE nskkzime_runtime oleaut32 user32)
  add_test(NAME tsf_learning COMMAND tsf_learning ${_test_dll} ${PROJECT_SOURCE_DIR}/tests/fixtures/basic.utf8.skk)
  set_tests_properties(tsf_learning PROPERTIES TIMEOUT 40)
  add_executable(tsf_zenz tests/tsf_zenz.cpp)
  target_link_libraries(tsf_zenz PRIVATE nskkzime_inference oleaut32)
  add_test(NAME tsf_zenz COMMAND tsf_zenz ${_test_dll}
    "${NSKKZIME_HOST_BUILD_DIRECTORY}/$<CONFIG>/nkkz-ime-server.exe"
    "${PROJECT_SOURCE_DIR}/out/models/zenz-v3.2-small/ggml-model-Q5_K_M.gguf")
  set_tests_properties(tsf_zenz PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 60)
  add_executable(tsf_registration_tests tests/tsf_registration_tests.cpp src/windows/registration_registry.cpp)
  target_include_directories(tsf_registration_tests PRIVATE src/windows)
  target_link_libraries(tsf_registration_tests PRIVATE project_options advapi32 ole32 uuid)
  add_test(NAME tsf_registration COMMAND tsf_registration_tests)
  add_executable(cpu_requirements_tests tests/cpu_requirements_tests.cpp)
  target_include_directories(cpu_requirements_tests SYSTEM PRIVATE third_party)
  target_link_libraries(cpu_requirements_tests PRIVATE nskkzime_runtime)
  add_test(NAME cpu_requirements COMMAND cpu_requirements_tests)
  if(NSKKZIME_ARM64X_MODE OR NSKKZIME_TEST_TSF_DLL OR NSKKZIME_ARM64X_X86_HOST)
    add_executable(tsf_architecture_tests tests/tsf_architecture_tests.cpp)
    target_include_directories(tsf_architecture_tests PRIVATE src/windows)
    target_include_directories(tsf_architecture_tests SYSTEM PRIVATE third_party)
    target_link_libraries(tsf_architecture_tests PRIVATE project_options ole32 oleaut32 uuid user32)
    add_test(NAME tsf_architecture COMMAND tsf_architecture_tests ${_test_dll})
  endif()
  if(NOT NSKKZIME_TEST_TSF_DLL OR NSKKZIME_ARM64X_MODE)
    add_dependencies(tsf_smoke nskkzime_tsf)
    add_dependencies(tsf_learning nskkzime_tsf)
    add_dependencies(tsf_zenz nskkzime_tsf)
  endif()
  get_property(project_tests DIRECTORY PROPERTY TESTS)
  # Tests choose their own isolated settings; anything else fails instead of reading the user's.
  set_tests_properties(${project_tests} PROPERTIES ENVIRONMENT_MODIFICATION
    "NSKKZIME_CONFIG=set:${CMAKE_CURRENT_BINARY_DIR}/no-test-settings.ini")
endif()
if(NOT NSKKZIME_X86_COMPANION AND (NSKKZIME_ARM64X_MODE OR NSKKZIME_TEST_TSF_DLL))
  get_property(_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" _host_arch)
  foreach(_target IN LISTS _targets)
    get_target_property(_type ${_target} TYPE)
    if(_type STREQUAL "EXECUTABLE")
      set_target_properties(${_target} PROPERTIES OUTPUT_NAME "${_target}-${_host_arch}")
    endif()
  endforeach()
endif()
