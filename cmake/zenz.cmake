set(NSKKZIME_LLAMA_REVISION "66afb885a8ddcc0511798aec9fb5a01017941018")
set(NSKKZIME_LLAMA_VARIANT "azookey" CACHE STRING "azookey or upstream-v0.6.0 (experimental)")
set_property(CACHE NSKKZIME_LLAMA_VARIANT PROPERTY STRINGS azookey upstream-v0.6.0)
if(NSKKZIME_LLAMA_VARIANT STREQUAL "upstream-v0.6.0")
  set(NSKKZIME_LLAMA_REVISION "8345f333951c661d166b00e6f9362e553768f292")
elseif(NOT NSKKZIME_LLAMA_VARIANT STREQUAL "azookey")
  message(FATAL_ERROR "Unknown NSKKZIME_LLAMA_VARIANT: ${NSKKZIME_LLAMA_VARIANT}")
endif()
set(NSKKZIME_LLAMA_DIR "${PROJECT_SOURCE_DIR}/out/deps/llama.cpp-${NSKKZIME_LLAMA_REVISION}" CACHE PATH "Pinned azooKey llama.cpp source")
if(NOT EXISTS "${NSKKZIME_LLAMA_DIR}/CMakeLists.txt")
  message(FATAL_ERROR "Run scripts/prepare-zenz.ps1 before configuring the zenz build.")
endif()
enable_language(C)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
foreach(opt LLAMA_BUILD_COMMON LLAMA_BUILD_TESTS LLAMA_BUILD_TOOLS LLAMA_BUILD_EXAMPLES
    LLAMA_BUILD_SERVER LLAMA_BUILD_APP LLAMA_BUILD_UI LLAMA_OPENSSL LLAMA_LLGUIDANCE
    GGML_OPENMP GGML_NATIVE GGML_CUDA GGML_VULKAN GGML_METAL GGML_RPC GGML_BUILD_TESTS GGML_BUILD_EXAMPLES)
  set(${opt} OFF CACHE BOOL "" FORCE)
endforeach()
if(NSKKZIME_LLAMA_VARIANT STREQUAL "azookey")
  set(LLAMA_BUILD_NUMBER 9637)
else()
  set(LLAMA_BUILD_NUMBER 0)
  set(LLAMA_BUILD_IS_DEV OFF CACHE BOOL "" FORCE)
endif()
set(LLAMA_BUILD_COMMIT "${NSKKZIME_LLAMA_REVISION}")
# One CPU product contract, matching the baseline parent-side preflight. Do not
# silently retain stronger ISA variants from a previous CMake cache.
foreach(opt GGML_CPU GGML_SSE42 GGML_AVX GGML_AVX2 GGML_BMI2)
  set(${opt} ON CACHE BOOL "" FORCE)
endforeach()
foreach(opt GGML_BACKEND_DL GGML_CPU_ALL_VARIANTS GGML_AVX_VNNI GGML_AVX512
    GGML_AVX512_VBMI GGML_AVX512_VNNI GGML_AVX512_BF16 GGML_AMX_TILE GGML_AMX_INT8 GGML_AMX_BF16)
  set(${opt} OFF CACHE BOOL "" FORCE)
endforeach()
function(nskkzime_add_llama)
  # The pinned fork uses C++17 UTF-8 literals; our own code remains C++20.
  set(CMAKE_CXX_STANDARD 17)
  # An extracted archive must not identify itself as the enclosing IME repo.
  set(GIT_EXE "")
  add_subdirectory("${NSKKZIME_LLAMA_DIR}" "${PROJECT_BINARY_DIR}/llama" EXCLUDE_FROM_ALL)
endfunction()
if(CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
  include("${CMAKE_CURRENT_LIST_DIR}/llama_arm64.cmake")
else()
  nskkzime_add_llama()
endif()
add_library(zenz_prompt STATIC third_party/skk-zenz/prompt.cpp)
target_include_directories(zenz_prompt PUBLIC third_party/skk-zenz)
add_library(zenz_model STATIC third_party/skk-zenz/model.cpp)
target_include_directories(zenz_model PUBLIC third_party/skk-zenz)
target_link_libraries(zenz_model PRIVATE llama)
if(MSVC)
  target_compile_options(zenz_prompt PRIVATE /utf-8)
  target_compile_options(zenz_model PRIVATE /utf-8)
endif()
add_library(nskkzime_zenz STATIC src/server/zenz_backend.cpp)
target_include_directories(nskkzime_zenz PUBLIC src/server)
target_link_libraries(nskkzime_zenz PUBLIC nskkzime_protocol PRIVATE zenz_prompt zenz_model)
if(BUILD_TESTING)
  add_executable(zenz_tokenizer_tests tests/zenz_tokenizer_tests.cpp)
  target_include_directories(zenz_tokenizer_tests SYSTEM PRIVATE third_party)
  target_link_libraries(zenz_tokenizer_tests PRIVATE llama zenz_prompt project_options)
  add_executable(zenz_prompt_tests third_party/skk-zenz/tests/test_prompt.cpp)
  target_link_libraries(zenz_prompt_tests PRIVATE zenz_prompt project_options)
  add_test(NAME zenz_prompt COMMAND zenz_prompt_tests)
  add_executable(zenz_model_tests third_party/skk-zenz/tests/test_model.cpp)
  target_link_libraries(zenz_model_tests PRIVATE zenz_model zenz_prompt project_options)
  target_compile_definitions(zenz_model_tests PRIVATE _CRT_SECURE_NO_WARNINGS)
  set(NSKKZIME_ZENZ_TEST_MODEL "${PROJECT_SOURCE_DIR}/out/models/zenz-v3.2-small/ggml-model-Q5_K_M.gguf" CACHE FILEPATH "GGUF used for real-model tests")
  add_test(NAME zenz_tokenizer COMMAND zenz_tokenizer_tests ${NSKKZIME_ZENZ_TEST_MODEL}
    ${PROJECT_SOURCE_DIR}/tests/fixtures/zenz-tokenizer-v3.2.json)
  set_tests_properties(zenz_tokenizer PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 30)
  add_test(NAME zenz_model COMMAND zenz_model_tests)
  set_tests_properties(zenz_model PROPERTIES ENVIRONMENT "ZENZ_MODEL=${NSKKZIME_ZENZ_TEST_MODEL}" SKIP_RETURN_CODE 77 TIMEOUT 120)
