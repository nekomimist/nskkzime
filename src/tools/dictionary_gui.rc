#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "dictionary_gui_ids.h"
IDD_DICTIONARY_MANAGER DIALOGEX 0, 0, 520, 365
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "nskkzime 学習辞書"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "", IDC_STORE, 8, 8, 504, 25, SS_NOPREFIX
    LTEXT "絞り込み(&F)", -1, 8, 38, 60, 12
    EDITTEXT IDC_SEARCH, 72, 35, 290, 16, ES_AUTOHSCROLL
    LTEXT "", IDC_COUNT, 370, 38, 142, 12
    CONTROL "", IDC_WORDS, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA, 8, 58, 504, 150
    LTEXT "選択した語（送りが空の行は、その送りキーに共通の候補です）", -1, 8, 213, 504, 12
    EDITTEXT IDC_DETAIL, 8, 229, 504, 42, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON "再読込(&R)", IDC_REFRESH, 8, 279, 68, 16
    PUSHBUTTON "選択語を削除(&D)…", IDC_FORGET, 82, 279, 96, 16
    PUSHBUTTON "SKKを取り込む(&I)…", IDC_IMPORT, 184, 279, 96, 16
    PUSHBUTTON "全件を書き出す(&E)…", IDC_EXPORT, 286, 279, 102, 16
    LTEXT "状態", -1, 8, 302, 30, 12
    EDITTEXT IDC_STATUS, 8, 317, 406, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON "閉じる", IDCANCEL, 430, 339, 82, 18
END
