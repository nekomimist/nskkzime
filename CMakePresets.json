{
  "version": 5,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "nskkzime / Visual Studio 2022 / x64 / zenz CPU",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64-zenz",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NSKKZIME_WITH_ZENZ": "ON"
      }
    },
    {
      "name": "windows-x64-zenz",
      "inherits": "windows-x64",
      "displayName": "Compatibility alias for windows-x64"
    },
    {
      "name": "windows-x64-test-only",
      "inherits": "windows-x64",
      "displayName": "Lightweight tests only / no zenz / not distributable",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "cacheVariables": {
        "NSKKZIME_WITH_ZENZ": "OFF"
      }
    },
    {
      "name": "windows-x64-upstream-experimental",
      "inherits": "windows-x64",
      "displayName": "Experimental upstream llama.cpp v0.6.0 with zenz tokenizer patch",
      "binaryDir": "${sourceDir}/out/build/windows-x64-upstream-experimental",
      "cacheVariables": {
        "NSKKZIME_LLAMA_VARIANT": "upstream-v0.6.0"
      }
    },
    {
      "name": "windows-arm64-upstream-experimental",
      "inherits": "windows-x64-upstream-experimental",
      "displayName": "Experimental ARM64 / MSVC product + ClangCL llama.cpp / Release only",
      "architecture": "ARM64",
      "binaryDir": "${sourceDir}/out/build/windows-arm64-upstream-experimental",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    },
    {
      "name": "windows-arm64-test-only",
      "inherits": "windows-x64-test-only",
      "displayName": "Experimental ARM64 / MSVC / no zenz / not distributable",
      "architecture": "ARM64",
      "binaryDir": "${sourceDir}/out/build/windows-arm64-test-only"
    },
    {
      "name": "windows-arm64x-native",
      "inherits": "windows-arm64-test-only",
      "displayName": "Experimental ARM64X native TSF inputs / Release only",
      "binaryDir": "${sourceDir}/out/build/windows-arm64x-native",
      "cacheVariables": {
        "NSKKZIME_TSF_COMPANION": "ON",
        "NSKKZIME_ARM64X_MODE": "NATIVE",
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "NSKKZIME_HOST_BUILD_DIRECTORY": "${sourceDir}/out/build/windows-arm64-upstream-experimental",
        "NSKKZIME_TEST_TSF_DLL": "${sourceDir}/out/arm64x/Release/nskkzime_tsf.dll"
      }
    },
    {
      "name": "windows-arm64x-ec",
      "inherits": "windows-arm64x-native",
      "displayName": "Experimental ARM64X EC TSF merge / Release only",
      "architecture": "ARM64EC",
      "binaryDir": "${sourceDir}/out/build/windows-arm64x-ec",
      "cacheVariables": {"NSKKZIME_ARM64X_MODE": "EC"}
    },
    {
      "name": "windows-arm64x-x64-host",
      "inherits": "windows-arm64x-native",
      "displayName": "x64 hosts for unregistered ARM64X validation",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-arm64x-x64-host",
      "cacheVariables": {"NSKKZIME_ARM64X_MODE": ""}
    },
    {
      "name": "windows-arm64x-x86-host",
      "inherits": "windows-x86",
      "displayName": "x86 TSF companion using ARM64 services",
      "binaryDir": "${sourceDir}/out/build/windows-arm64x-x86-host",
      "cacheVariables": {
        "NSKKZIME_HOST_BUILD_DIRECTORY": "${sourceDir}/out/arm64x",
        "NSKKZIME_ARM64X_X86_HOST": "ON"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "32-bit TSF companion / x64 services",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/windows-x86",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NSKKZIME_WITH_ZENZ": "OFF",
        "NSKKZIME_X86_COMPANION": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "windows-x64", "configuration": "Debug"},
    {"name": "release", "configurePreset": "windows-x64", "configuration": "Release"},
    {"name": "debug-zenz", "inherits": "debug"},
    {"name": "release-zenz", "inherits": "release"},
    {"name": "debug-test-only", "configurePreset": "windows-x64-test-only", "configuration": "Debug"},
    {"name": "release-test-only", "configurePreset": "windows-x64-test-only", "configuration": "Release"},
    {"name": "release-upstream-experimental", "configurePreset": "windows-x64-upstream-experimental", "configuration": "Release"},
    {"name": "release-arm64-upstream-experimental", "configurePreset": "windows-arm64-upstream-experimental", "configuration": "Release"},
    {"name": "release-arm64x-native", "configurePreset": "windows-arm64x-native", "configuration": "Release"},
    {"name": "release-arm64x-ec", "configurePreset": "windows-arm64x-ec", "configuration": "Release"},
    {"name": "release-arm64x-x64-host", "configurePreset": "windows-arm64x-x64-host", "configuration": "Release"},
    {"name": "release-arm64x-x86-host", "configurePreset": "windows-arm64x-x86-host", "configuration": "Release"},
    {"name": "debug-arm64-test-only", "configurePreset": "windows-arm64-test-only", "configuration": "Debug"},
    {"name": "release-arm64-test-only", "configurePreset": "windows-arm64-test-only", "configuration": "Release"},
    {"name": "debug-x86", "configurePreset": "windows-x86", "configuration": "Debug"},
    {"name": "release-x86", "configurePreset": "windows-x86", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "windows-x64", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "windows-x64", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "debug-zenz", "inherits": "debug"},
    {"name": "release-zenz", "inherits": "release"},
    {"name": "debug-test-only", "configurePreset": "windows-x64-test-only", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release-test-only", "configurePreset": "windows-x64-test-only", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "release-upstream-experimental", "configurePreset": "windows-x64-upstream-experimental", "configuration": "Release", "output": {"outputOnFailure": true}, "filter": {"exclude": {"name": "^installation$"}}},
    {"name": "release-arm64-upstream-experimental", "configurePreset": "windows-arm64-upstream-experimental", "configuration": "Release", "output": {"outputOnFailure": true}, "filter": {"exclude": {"name": "^(package|installation|scoop|scoop_windows_powershell)$"}}},
    {"name": "debug-arm64-test-only", "configurePreset": "windows-arm64-test-only", "configuration": "Debug", "output": {"outputOnFailure": true}, "filter": {"exclude": {"name": "^(package|installation|scoop|scoop_windows_powershell)$"}}},
    {"name": "release-arm64-test-only", "configurePreset": "windows-arm64-test-only", "configuration": "Release", "output": {"outputOnFailure": true}, "filter": {"exclude": {"name": "^(package|installation|scoop|scoop_windows_powershell)$"}}},
    {"name": "debug-x86", "configurePreset": "windows-x86", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release-x86", "configurePreset": "windows-x86", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
