# Every command has an explicit isolated source or an isolated settings folder.
# Earlier runs' helpers have idled out long ago, so their folders can be cleared first.
file(REMOVE_RECURSE "${TEST_ROOT}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef instance)
set(root "${TEST_ROOT}/${instance}")
file(MAKE_DIRECTORY "${root}")
set(source "${root}/user-dictionary.nskkdb")
set(export "${root}/export.skk")
set(ENV{NSKKZIME_CONFIG} "relative-invalid-settings.ini")
execute_process(COMMAND "${TEST_EXE}" --seed "${source}" RESULT_VARIABLE seeded)
if(NOT seeded EQUAL 0)
  message(FATAL_ERROR "Could not seed isolated CLI fixture")
endif()
function(run expected)
  execute_process(COMMAND "${USER_EXE}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "user dictionary ${ARGN}: exit ${result}, expected ${expected}\n${output}${error}")
  endif()
  set(output "${output}" PARENT_SCOPE)
endfunction()
run(0 --file "${source}" --list)
string(REGEX MATCH "[^\r\n]+" first "${output}")
string(JSON reading GET "${first}" reading)
string(JSON spelling GET "${first}" text)
if(NOT reading STREQUAL "AI" OR NOT spelling STREQUAL "(a/b);\\\"𠮷")
  message(FATAL_ERROR "JSON listing lost Unicode or escaped characters: ${first}")
endif()
run(0 --file "${source}" --export "${export}")
run(2 --file "${source}" --export "${export}")
run(0 --file "${source}" --forget かんじ 感じ)
run(0 --file "${source}" --forget か 描 --okuri k く)
run(0 --file "${source}" --list)
if(output MATCHES "感じ|描" OR NOT output MATCHES "漢字" OR NOT output MATCHES "書")
  message(FATAL_ERROR "CLI deletion affected wrong entry: ${output}")
endif()
# Without --file the store is the one beside the selected settings file.
set(ENV{NSKKZIME_CONFIG} "${root}/settings.ini")
run(0 --list)
if(NOT output MATCHES "漢字")
  message(FATAL_ERROR "Settings-folder store was not used by default")
endif()
# Export then import into a new store keeps every entry.
set(restored "${root}/restored.nskkdb")
run(0 --file "${restored}" --check-import "${export}")
run(0 --file "${restored}" --import "${export}")
run(0 --file "${restored}" --list)
string(REGEX REPLACE "[^\n]" "" restored_lines "${output}")
string(LENGTH "${restored_lines}" restored_count)
if(NOT restored_count EQUAL 5 OR NOT output MATCHES "𠮷")
  message(FATAL_ERROR "Export/import roundtrip lost entries")
endif()
file(WRITE "${root}/import.skk" ";; okuri-ari entries.\nかk /書;一般/描/[く/描;個別/]/\n;; okuri-nasi entries.\nかんじ /漢字;新注釈/新語/感じ/\n")
run(0 --file "${source}" --import "${root}/import.skk")
run(0 --file "${source}" --list)
if(NOT output MATCHES "新語" OR NOT output MATCHES "一般" OR NOT output MATCHES "個別")
  message(FATAL_ERROR "Import lost generic or exact candidates")
endif()
# EUC-JP 'かな /仮名/'.
string(ASCII 164 171 164 202 32 47 178 190 204 190 47 10 euc)
file(WRITE "${root}/euc.skk" "${euc}")
run(0 --file "${restored}" --import "${root}/euc.skk" --encoding euc-jp)
run(0 --file "${restored}" --list)
if(NOT output MATCHES "仮名")
  message(FATAL_ERROR "EUC-JP import lost kana or kanji")
endif()
# A file with a bad line is rejected as a whole.
file(SHA256 "${source}" import_before)
file(WRITE "${root}/bad-import.skk" "あ /新規/\nbad line\n")
run(2 --file "${source}" --import "${root}/bad-import.skk")
file(SHA256 "${source}" import_after)
if(NOT import_before STREQUAL import_after)
  message(FATAL_ERROR "Invalid import changed the dictionary")
endif()
