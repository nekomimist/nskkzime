# Every command has an explicit isolated source or an isolated environment override.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef instance)
set(root "${TEST_ROOT}/${instance}")
file(MAKE_DIRECTORY "${root}")
set(source "${root}/user.nskkdb")
set(export "${root}/export.skk")
set(ENV{NSKKZIME_CONFIG} "relative-invalid-settings.ini")
set(ENV{NSKKZIME_USER_DICTIONARY} "relative-invalid-store.nskkdb")
execute_process(COMMAND "${TEST_EXE}" --seed "${source}" RESULT_VARIABLE seeded)
if(NOT seeded EQUAL 0)
  message(FATAL_ERROR "Could not seed isolated CLI fixture")
endif()
function(run expected)
  execute_process(COMMAND "${USER_EXE}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "user dictionary ${ARGN}: exit ${result}, expected ${expected}\n${output}${error}")
  endif()
  set(output "${output}" PARENT_SCOPE)
endfunction()
run(0 --help)
run(2 --list)
run(2 --file relative.nskkdb --list)
run(2 --file "${source}" --forget)
run(2 --file "${source}" --forget か 描 --okuri K く)
run(2 --file "${source}" --list extra)
file(SHA256 "${source}" before)
run(0 --file "${source}" --list)
string(REGEX MATCH "[^\r\n]+" first "${output}")
string(JSON reading GET "${first}" reading)
string(JSON spelling GET "${first}" text)
if(NOT reading STREQUAL "AI" OR NOT spelling STREQUAL "(a/b);\\\"𠮷")
  message(FATAL_ERROR "JSON listing lost Unicode or escaped characters: ${first}")
endif()
run(0 --file "${source}" --export "${export}")
file(SHA256 "${export}" exported)
run(2 --file "${source}" --export "${export}")
run(2 --file "${source}" --export "${source}")
run(2 --file "${source}" --export relative.skk)
file(SHA256 "${source}" after)
file(SHA256 "${export}" after_export)
if(NOT before STREQUAL after OR NOT exported STREQUAL after_export)
  message(FATAL_ERROR "Read/export/invalid command changed existing files")
endif()
run(0 --file "${source}" --forget かんじ 感じ)
run(0 --file "${source}" --forget か 描 --okuri k く)
run(0 --file "${source}" --list)
if(output MATCHES "感じ|描" OR NOT output MATCHES "漢字" OR NOT output MATCHES "書")
  message(FATAL_ERROR "CLI deletion affected wrong entry: ${output}")
endif()
set(ENV{NSKKZIME_USER_DICTIONARY} "${source}")
run(0 --list)
if(NOT output MATCHES "漢字")
  message(FATAL_ERROR "Environment override was not honored")
endif()
run(0 --file "${source}" --forget ない 無い)
run(0 --file "${root}/missing.nskkdb" --list)
if(NOT output STREQUAL "")
  message(FATAL_ERROR "Missing store was not listed as empty")
endif()
file(WRITE "${root}/broken.nskkdb" "broken user data")
run(2 --file "${root}/broken.nskkdb" --list)
run(2 --file "${root}/broken.nskkdb" --export "${root}/bad-export.skk")
if(EXISTS "${root}/bad-export.skk")
  message(FATAL_ERROR "Corrupt database was exported as an empty dictionary")
endif()
# Allow the helper's normal 10-second idle shutdown, then remove only known files.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 11)
file(REMOVE "${source}" "${source}.lock" "${export}" "${root}/broken.nskkdb")
