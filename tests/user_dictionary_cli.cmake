# Every command has an explicit isolated source or an isolated environment override.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef instance)
set(root "${TEST_ROOT}/${instance}")
file(MAKE_DIRECTORY "${root}")
set(source "${root}/user.nskkdb")
set(export "${root}/export.skk")
set(ENV{NSKKZIME_CONFIG} "relative-invalid-settings.ini")
set(ENV{NSKKZIME_USER_DICTIONARY} "relative-invalid-store.nskkdb")
execute_process(COMMAND "${TEST_EXE}" --seed "${source}" RESULT_VARIABLE seeded)
if(NOT seeded EQUAL 0)
  message(FATAL_ERROR "Could not seed isolated CLI fixture")
endif()
function(run expected)
  execute_process(COMMAND "${USER_EXE}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "user dictionary ${ARGN}: exit ${result}, expected ${expected}\n${output}${error}")
  endif()
  set(output "${output}" PARENT_SCOPE)
endfunction()
run(0 --help)
run(2 --list)
run(2 --file relative.nskkdb --list)
run(2 --file "${source}" --forget)
run(2 --file "${source}" --forget か 描 --okuri K く)
run(2 --file "${source}" --list extra)
file(SHA256 "${source}" before)
run(0 --file "${source}" --list)
string(REGEX MATCH "[^\r\n]+" first "${output}")
string(JSON reading GET "${first}" reading)
string(JSON spelling GET "${first}" text)
if(NOT reading STREQUAL "AI" OR NOT spelling STREQUAL "(a/b);\\\"𠮷")
  message(FATAL_ERROR "JSON listing lost Unicode or escaped characters: ${first}")
endif()
run(0 --file "${source}" --export "${export}")
file(SHA256 "${export}" exported)
run(2 --file "${source}" --export "${export}")
run(2 --file "${source}" --export "${source}")
run(2 --file "${source}" --export relative.skk)
file(SHA256 "${source}" after)
file(SHA256 "${export}" after_export)
if(NOT before STREQUAL after OR NOT exported STREQUAL after_export)
  message(FATAL_ERROR "Read/export/invalid command changed existing files")
endif()
run(0 --file "${source}" --forget かんじ 感じ)
run(0 --file "${source}" --forget か 描 --okuri k く)
run(0 --file "${source}" --list)
if(output MATCHES "感じ|描" OR NOT output MATCHES "漢字" OR NOT output MATCHES "書")
  message(FATAL_ERROR "CLI deletion affected wrong entry: ${output}")
endif()
set(ENV{NSKKZIME_USER_DICTIONARY} "${source}")
run(0 --list)
if(NOT output MATCHES "漢字")
  message(FATAL_ERROR "Environment override was not honored")
endif()
run(0 --file "${source}" --forget ない 無い)
run(0 --file "${root}/missing.nskkdb" --list)
if(NOT output STREQUAL "")
  message(FATAL_ERROR "Missing store was not listed as empty")
endif()
file(WRITE "${root}/broken.nskkdb" "broken user data")
run(2 --file "${root}/broken.nskkdb" --list)
run(2 --file "${root}/broken.nskkdb" --export "${root}/bad-export.skk")
if(EXISTS "${root}/bad-export.skk")
  message(FATAL_ERROR "Corrupt database was exported as an empty dictionary")
endif()
set(restored "${root}/restored.nskkdb")
run(0 --file "${restored}" --check-import "${export}" --encoding utf-8)
if(EXISTS "${restored}" OR EXISTS "${restored}.lock")
  message(FATAL_ERROR "Import preflight created a database or launched a writer")
endif()
run(0 --file "${restored}" --import "${export}")
run(0 --file "${restored}" --list)
string(REGEX REPLACE "[^\n]" "" restored_lines "${output}")
string(LENGTH "${restored_lines}" restored_count)
if(NOT restored_count EQUAL 5 OR NOT output MATCHES "𠮷")
  message(FATAL_ERROR "Export/import roundtrip lost entries")
endif()
file(WRITE "${root}/import.skk" ";; okuri-ari entries.\nかk /書;一般/描/[く/描;個別/]/\n;; okuri-nasi entries.\nかんじ /漢字;新注釈/新語/感じ/\n")
run(0 --file "${source}" --import "${root}/import.skk")
run(0 --file "${source}" --list)
set(imported_rows "${output}")
if(NOT output MATCHES "新語" OR NOT output MATCHES "一般" OR NOT output MATCHES "個別")
  message(FATAL_ERROR "Import lost generic or exact candidates")
endif()
run(0 --file "${source}" --import "${root}/import.skk")
run(0 --file "${source}" --list)
if(NOT output STREQUAL imported_rows)
  message(FATAL_ERROR "Repeated import changed existing priorities or annotations")
endif()
file(SHA256 "${source}" import_before)
file(WRITE "${root}/bad-import.skk" "あ /新規/\nbad line\n")
run(2 --file "${source}" --check-import "${root}/bad-import.skk")
run(2 --file "${source}" --import "${root}/bad-import.skk")
file(WRITE "${root}/bad-import.skk" "あ /新規/(unknown-function)/\n")
run(2 --file "${source}" --import "${root}/bad-import.skk")
run(2 --file "${source}" --import "${source}")
run(2 --file "${source}" --import relative.skk)
run(2 --file "${source}" --import "${root}/absent.skk")
run(2 --file "${source}" --import "${root}/import.skk" --encoding invalid)
run(2 --file "${source}" --forget か 書 --okuri k "")
run(2 --file "${source}" --forget か 書 --okuri-key K)
file(SHA256 "${source}" import_after)
if(NOT import_before STREQUAL import_after)
  message(FATAL_ERROR "Invalid import or generic deletion changed the dictionary")
endif()
run(2 --file "${root}/broken.nskkdb" --import "${export}")
run(0 --file "${source}" --forget か 描 --okuri-key k)
run(0 --file "${source}" --list)
string(REPLACE ";" "\\;" escaped_rows "${output}")
string(REGEX MATCHALL "[^\r\n]+" scopes "${escaped_rows}")
set(found_exact FALSE)
foreach(row IN LISTS scopes)
  string(JSON word GET "${row}" text)
  string(JSON suffix GET "${row}" okuri)
  if(word STREQUAL "描")
    if(suffix STREQUAL "")
      message(FATAL_ERROR "Generic okuri candidate was not deleted")
    endif()
    if(suffix STREQUAL "く")
      set(found_exact TRUE)
    endif()
  endif()
endforeach()
if(NOT found_exact)
  message(FATAL_ERROR "Generic deletion affected an exact okuri scope")
endif()
# EUC-JP 'かな /仮名/': exercise the same decoder through the import CLI.
string(ASCII 164 171 164 202 32 47 178 190 204 190 47 10 euc)
file(WRITE "${root}/euc.skk" "${euc}")
run(0 --file "${restored}" --import "${root}/euc.skk" --encoding euc-jp)
run(0 --file "${restored}" --list)
if(NOT output MATCHES "仮名")
  message(FATAL_ERROR "EUC-JP import lost kana or kanji")
endif()
file(WRITE "${root}/empty.skk" ";; no entries\n")
run(0 --file "${root}/empty.nskkdb" --import "${root}/empty.skk")
if(EXISTS "${root}/empty.nskkdb" OR EXISTS "${root}/empty.nskkdb.lock")
  message(FATAL_ERROR "Empty import created a writer or database")
endif()
# Allow the helper's normal 10-second idle shutdown, then remove only known files.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 11)
file(REMOVE "${source}" "${source}.lock" "${export}" "${root}/broken.nskkdb"
  "${restored}" "${restored}.lock" "${root}/import.skk" "${root}/bad-import.skk" "${root}/euc.skk" "${root}/empty.skk")
