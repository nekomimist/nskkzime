# Isolated child process environment; never use the user's saved configuration.
unset(ENV{NSKKZIME_CONFIG})
set(settings "${TEST_ROOT}/cli-settings.ini")
file(MAKE_DIRECTORY "${TEST_ROOT}")
function(run expected)
  execute_process(COMMAND "${CONFIG_EXE}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "config ${ARGN}: exit ${result}, expected ${expected}\n${output}${error}")
  endif()
endfunction()
# CPU inspection must not load even a malformed saved-settings path.
set(ENV{NSKKZIME_CONFIG} "relative-invalid-settings.ini")
execute_process(COMMAND "${CONFIG_EXE}" --check-cpu RESULT_VARIABLE cpu_exit OUTPUT_VARIABLE cpu_json ERROR_VARIABLE cpu_error)
string(JSON cpu_supported ERROR_VARIABLE cpu_parse_error GET "${cpu_json}" supported)
if(cpu_parse_error OR (cpu_supported AND NOT cpu_exit EQUAL 0) OR (NOT cpu_supported AND NOT cpu_exit EQUAL 3))
  message(FATAL_ERROR "invalid CPU check result: ${cpu_exit} ${cpu_json} ${cpu_error}")
endif()
unset(ENV{NSKKZIME_CONFIG})
run(2 --check-cpu unexpected)
run(0 --config "${settings}" --set-dictionaries "${DICTIONARY}")
run(0 --config "${settings}" --show)
run(0 --config "${settings}" --check)
run(0 --config "${settings}" --set-learning off)
run(0 --config "${settings}" --set-startup-ime-off on)
run(0 --config "${settings}" --set-learning on)
file(READ "${settings}" startup)
if(NOT startup MATCHES "startup-ime-off=on")
  message(FATAL_ERROR "startup mode lost after another settings edit")
endif()
run(2 --config "${settings}" --set-startup-ime-off true)
run(2 --config "${settings}" --set-startup-ime-off)
run(2 --config "${settings}" --set-startup-ime-off on extra)
run(0 --config "${settings}" --set-startup-ime-off off)
file(READ "${settings}" startup)
if(startup MATCHES "startup-ime-off=on")
  message(FATAL_ERROR "startup mode stayed enabled")
endif()
run(0 --config "${settings}" --set-learning off)
run(0 --config "${settings}" --set-candidate-show-after 3)
run(0 --config "${settings}" --set-candidate-keys asdfjkl)
run(0 --config "${settings}" --set-off-key-exclusions Code.exe WindowsTerminal.exe)
run(0 --config "${settings}" --set-romaji "${ROMAJI}")
# These existing files validate configuration only; --set-zenz never runs them.
# Without SERVER the bundled server is used, so no path is saved.
run(0 --config "${settings}" --set-zenz "${DICTIONARY}")
file(READ "${settings}" bundled)
if(NOT bundled MATCHES "inference=zenz" OR bundled MATCHES "zenz-server=")
  message(FATAL_ERROR "model-only zenz setup saved a server path")
endif()
run(0 --config "${settings}" --set-zenz "${DICTIONARY}" "${CONFIG_EXE}")
file(READ "${settings}" override)
if(NOT override MATCHES "zenz-server=")
  message(FATAL_ERROR "development server override was not saved")
endif()
run(0 --config "${settings}" --set-zenz-min-length 12)
run(0 --config "${settings}" --set-zenz-rerank on)
run(0 --config "${settings}" --set-zenz-learning on)
run(0 --config "${settings}" --set-zenz-unknown-context on)
run(0 --config "${settings}" --enable-input-log "${TEST_ROOT}")
file(READ "${settings}" logging)
if(NOT logging MATCHES "input-log=on" OR NOT logging MATCHES "input-log-directory=")
  message(FATAL_ERROR "explicit input logging was not saved")
endif()
run(0 --config "${settings}" --disable-input-log)
file(READ "${settings}" logging)
if(NOT logging MATCHES "input-log=off" OR NOT logging MATCHES "input-log-directory=")
  message(FATAL_ERROR "disabling input logging lost destination or remained enabled")
endif()
run(0 --config "${settings}" --enable-tsf-log "${TEST_ROOT}")
file(READ "${settings}" tsf_logging)
if(NOT tsf_logging MATCHES "tsf-log=on" OR NOT tsf_logging MATCHES "tsf-log-directory=")
  message(FATAL_ERROR "TSF logging was not saved")
endif()
file(COPY_FILE "${settings}" "${TEST_ROOT}/tsf-disabled-inference.ini")
run(0 --config "${TEST_ROOT}/tsf-disabled-inference.ini" --disable-inference)
file(READ "${TEST_ROOT}/tsf-disabled-inference.ini" tsf_logging)
if(NOT tsf_logging MATCHES "tsf-log=on")
  message(FATAL_ERROR "inference toggle changed TSF logging")
endif()
run(0 --config "${settings}" --disable-tsf-log)
file(READ "${settings}" tsf_logging)
if(NOT tsf_logging MATCHES "tsf-log=off" OR NOT tsf_logging MATCHES "tsf-log-directory=")
  message(FATAL_ERROR "TSF log opt-out lost the destination")
endif()
run(0 --config "${settings}" --set-zenz "${DICTIONARY}" "${CONFIG_EXE}")
run(0 --config "${settings}" --set-dictionaries "${DICTIONARY}")
file(READ "${settings}" learning)
if(NOT learning MATCHES "learning=off")
  message(FATAL_ERROR "dictionary update reset the learning preference")
endif()
if(NOT learning MATCHES "candidate-show-after=3" OR NOT learning MATCHES "candidate-keys=asdfjkl")
  message(FATAL_ERROR "other settings updates reset candidate preferences")
endif()
if(NOT learning MATCHES "off-key-exclude=Code.exe" OR NOT learning MATCHES "off-key-exclude=WindowsTerminal.exe")
  message(FATAL_ERROR "other settings updates reset OFF key exclusions")
endif()
if(NOT learning MATCHES "romaji=")
  message(FATAL_ERROR "dictionary update reset the romaji preference")
endif()
if(NOT learning MATCHES "inference=zenz")
  message(FATAL_ERROR "dictionary update reset inference")
endif()
if(NOT learning MATCHES "zenz-unknown-context=on")
  message(FATAL_ERROR "dictionary/model update reset context permission")
endif()
if(NOT learning MATCHES "zenz-min-length=12" OR NOT learning MATCHES "zenz-rerank=on" OR NOT learning MATCHES "zenz-learn-fallback=on")
  message(FATAL_ERROR "dictionary/model update reset inference policy")
endif()
run(0 --config "${settings}" --check)
run(2 --config "${settings}" --set-learning invalid)
file(SHA256 "${settings}" before)
run(2 --config "${settings}" --set-off-key-exclusions Code.exe code.EXE)
run(2 --config "${settings}" --set-off-key-exclusions "C:/Code.exe")
run(2 --config "${settings}" --set-off-key-exclusions "*.exe")
run(2 --config "${settings}" --enable-tsf-log)
run(2 --config "${settings}" --enable-tsf-log relative)
run(2 --config "${settings}" --enable-tsf-log "${TEST_ROOT}/missing-directory")
run(2 --config "${settings}" --disable-tsf-log unexpected)
run(2 --config "${settings}" --set-candidate-show-after 0)
run(2 --config "${settings}" --set-candidate-show-after 100)
run(2 --config "${settings}" --set-candidate-show-after 3x)
run(2 --config "${settings}" --set-candidate-show-after)
run(2 --config "${settings}" --set-candidate-keys qwerty)
run(2 --config "${settings}" --set-candidate-keys)
run(2 --config "${settings}" --set-candidate-keys numbers unexpected)
set(broken "${TEST_ROOT}/invalid-romaji.tsv")
file(WRITE "${broken}" "version=1\nwi\tゐ\nwi\tい\n")
run(2 --config "${settings}" --set-romaji "${broken}")
run(2 --config "${settings}" --set-dictionaries "${TEST_ROOT}/nonexistent.skk")
run(2 --config "${settings}" --set-dictionaries relative.skk)
run(2 --config "${settings}" --set-dictionaries)
run(2 --config "${settings}" --set-romaji "${TEST_ROOT}/missing.tsv")
run(2 --config "${settings}" --set-romaji relative.tsv)
run(2 --config "${settings}" --set-romaji)
run(2 --config "${settings}" --set-zenz)
run(2 --config "${settings}" --set-zenz "${DICTIONARY}" "${CONFIG_EXE}" unexpected)
run(2 --config "${settings}" --set-zenz "${DICTIONARY}" "${TEST_ROOT}/missing.exe")
run(2 --config "${settings}" --set-zenz relative.gguf "${CONFIG_EXE}")
run(2 --config "${settings}" --set-zenz-min-length -1)
run(2 --config "${settings}" --set-zenz-min-length 1025)
run(2 --config "${settings}" --set-zenz-rerank invalid)
run(2 --config "${settings}" --set-zenz-learning invalid)
run(2 --config "${settings}" --set-zenz-unknown-context invalid)
run(2 --config "${settings}" --set-zenz-unknown-context)
run(2 --config "${settings}" --enable-input-log relative)
run(2 --config "${settings}" --enable-input-log "${TEST_ROOT}/missing-log-directory")
run(2 --config "${settings}" --enable-input-log)
run(2 --config "${settings}" --disable-input-log unexpected)
file(SHA256 "${settings}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "invalid CLI update changed saved configuration")
endif()
set(ENV{NSKKZIME_CONFIG} "${settings}")
run(0 --check)
unset(ENV{NSKKZIME_CONFIG})
run(0 --config "${settings}" --disable-dictionaries)
file(READ "${settings}" disabled)
if(disabled MATCHES "\ndictionary=")
  message(FATAL_ERROR "disable left a dictionary configured")
endif()
if(NOT disabled MATCHES "romaji=")
  message(FATAL_ERROR "disable dictionaries reset the romaji preference")
endif()
run(0 --config "${settings}" --reset-romaji)
file(READ "${settings}" reset)
if(reset MATCHES "\nromaji=")
  message(FATAL_ERROR "reset left custom romaji configured")
endif()
run(0 --config "${settings}" --check)
run(0 --config "${settings}" --disable-inference)
run(0 --config "${settings}" --set-off-key-exclusions)
file(READ "${settings}" cleared_exclusions)
if(cleared_exclusions MATCHES "off-key-exclude=")
  message(FATAL_ERROR "clearing OFF key exclusions retained entries")
endif()
run(0 --config "${settings}" --set-zenz-unknown-context off)
file(READ "${settings}" inference_off)
if(inference_off MATCHES "\ninference=zenz" OR inference_off MATCHES "\nzenz-model=")
  message(FATAL_ERROR "disable inference retained model configuration")
endif()
run(2 --config "${TEST_ROOT}/missing.ini" --check)
# Delete only the file created by this test, leaving the test directory in out/.
file(REMOVE "${settings}" "${broken}")
